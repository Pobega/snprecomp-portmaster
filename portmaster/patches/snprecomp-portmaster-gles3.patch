+bool is_menu_cursor_active() {
+    uint32_t last = s_last_menu_cursor_ms.load(std::memory_order_relaxed);
+    if (last == 0) {
+        return false;
+    }
+    return (SDL_GetTicks() - last) <= RETICLE_ACTIVE_TIMEOUT_MS;
+}
