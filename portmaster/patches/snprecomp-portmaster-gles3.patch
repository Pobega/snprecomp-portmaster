+namespace {
+    constexpr uint64_t FNV1A_OFFSET_BASIS = 0xcbf29ce484222325ULL;
+    constexpr uint64_t FNV1A_PRIME = 0x100000001b3ULL;
+
+    inline uint64_t fnv1a_step(uint64_t hash, uint8_t byte) {
+        return (hash ^ byte) * FNV1A_PRIME;
+    }
+
+    inline uint64_t fnv1a_bytes(uint64_t hash, const void* data, size_t size) {
+        const auto* ptr = static_cast<const uint8_t*>(data);
+        size_t i = 0;
+        while (i + 8 <= size) {
+            uint64_t chunk = 0;
+            std::memcpy(&chunk, ptr + i, sizeof(chunk));
+            hash = (hash ^ chunk) * FNV1A_PRIME;
+            i += 8;
+        }
+        while (i < size) {
+            hash = fnv1a_step(hash, ptr[i]);
+            ++i;
+        }
+        return hash;
+    }
+
+    uint32_t get_bytes_per_texel_numerator(uint8_t siz) {
+        switch (siz) {
+            case G_IM_SIZ_4b: return 1;
+            case G_IM_SIZ_8b: return 1;
+            case G_IM_SIZ_16b: return 2;
+            case G_IM_SIZ_32b: return 4;
+            default: return 2;
+        }
+    }
+}
+
+TmemTextureCache::TmemTextureCache() {
+    std::memset(tmem_, 0, sizeof(tmem_));
+}
+
+TmemTextureCache::~TmemTextureCache() {
+    reset();
+}
+
+void TmemTextureCache::reset() {
+    for (auto& item : lru_list_) {
+        if (item.texture_id != 0 && gl::glDeleteTextures) {
+            gl::glDeleteTextures(1, &item.texture_id);
+        }
+    }
+    lru_list_.clear();
+    cache_map_.clear();
+    for (const auto& rec : recycled_textures_) {
+        if (rec.texture_id != 0 && gl::glDeleteTextures) {
+            gl::glDeleteTextures(1, &rec.texture_id);
+        }
+    }
+    recycled_textures_.clear();
+    std::memset(tmem_, 0, sizeof(tmem_));
+    for (auto& tile : tiles_) {
+        tile = TileDescriptor{};
+    }
+    timg_ = TextureImageState{};
+    tmem_generation_++;
+    for (auto& g : tile_generation_) {
+        g++;
+    }
+    for (auto& slot : fast_slots_) {
+        slot.valid = false;
+    }
+}
+
+void TmemTextureCache::set_timg(uint8_t fmt, uint8_t siz, uint32_t width, uint32_t phys_addr) {
+    timg_.fmt = fmt;
+    timg_.siz = siz;
+    timg_.width = width;
+    timg_.phys_addr = physical_rdram_offset(phys_addr);
+}
+
+void TmemTextureCache::set_tile(uint32_t tile_idx, uint8_t fmt, uint8_t siz, uint16_t line, uint16_t tmem,
+                                uint8_t palette, bool clamp_t, bool mirror_t, uint8_t mask_t, uint8_t shift_t,
+                                bool clamp_s, bool mirror_s, uint8_t mask_s, uint8_t shift_s) {
+    uint32_t idx = tile_idx & 7;
+    tile_generation_[idx]++;
+    TileDescriptor& tile = tiles_[idx];
+    tile.fmt = fmt;
+    tile.siz = siz;
+    tile.line = line;
+    tile.tmem = tmem;
+    tile.palette = palette;
+    tile.clamp_t = clamp_t;
+    tile.mirror_t = mirror_t;
+    tile.mask_t = mask_t;
+    tile.shift_t = shift_t;
+    tile.clamp_s = clamp_s;
+    tile.mirror_s = mirror_s;
+    tile.mask_s = mask_s;
+    tile.shift_s = shift_s;
+}
+
+void TmemTextureCache::set_tile_size(uint32_t tile_idx, uint16_t sl, uint16_t tl, uint16_t sh, uint16_t th) {
+    uint32_t idx = tile_idx & 7;
+    tile_generation_[idx]++;
+    TileDescriptor& tile = tiles_[idx];
+    tile.sl = sl;
+    tile.tl = tl;
+    tile.sh = sh;
+    tile.th = th;
+}
+
+void TmemTextureCache::load_block(uint32_t tile_idx, uint32_t uls, uint32_t ult, uint32_t lrs, uint32_t dxt, const uint8_t* rdram) {
+    (void)uls;
+    (void)ult;
+    tmem_generation_++;
+    for (auto& g : tile_generation_) {
+        g++;
+    }
+    TileDescriptor& tile = tiles_[tile_idx & 7];
+    uint32_t num_texels = lrs + 1;
+    uint32_t bytes_per_texel = get_bytes_per_texel_numerator(tile.siz);
+    uint32_t total_bytes = (tile.siz == G_IM_SIZ_4b) ? ((num_texels + 1) / 2) : (num_texels * bytes_per_texel);
+    uint32_t num_words = (total_bytes + 7) / 8;
+    num_words = std::min(num_words, 512u - (tile.tmem & 0x1FFu));
+
+    uint32_t dxt_acc = 0;
+    for (uint32_t i = 0; i < num_words; ++i) {
+        uint32_t tmem_word = (tile.tmem + i) & 0x1FFu;
+        bool odd_line = (dxt > 0) && (((dxt_acc >> 11) & 1u) != 0);
+        dxt_acc += dxt;
+        uint32_t rdram_phys = timg_.phys_addr + i * 8;
+        for (uint32_t b = 0; b < 8; ++b) {
+            uint32_t dest_byte = ((tmem_word * 8u + b) & 0xFFFu) ^ (odd_line ? 4u : 0u);
+            tmem_[dest_byte] = read_rdram_u8(rdram, rdram_phys + b);
+        }
+    }
+}
+
+void TmemTextureCache::load_tile(uint32_t tile_idx, uint32_t uls, uint32_t ult, uint32_t lrs, uint32_t lrt, const uint8_t* rdram) {
+    tmem_generation_++;
+    for (auto& g : tile_generation_) {
+        g++;
+    }
+    TileDescriptor& tile = tiles_[tile_idx & 7];
+    uint32_t ul_x = uls / 4;
+    uint32_t ul_y = ult / 4;
+    uint32_t lr_x = lrs / 4;
+    uint32_t lr_y = lrt / 4;
+    uint32_t width = (lr_x >= ul_x) ? (lr_x - ul_x + 1) : 1;
+    uint32_t height = (lr_y >= ul_y) ? (lr_y - ul_y + 1) : 1;
+
+    uint32_t bytes_per_texel = get_bytes_per_texel_numerator(tile.siz);
+    uint32_t row_bytes = (tile.siz == G_IM_SIZ_4b) ? ((width + 1) / 2) : (width * bytes_per_texel);
+    uint32_t words_per_row = (row_bytes + 7) / 8;
+
+    for (uint32_t y = 0; y < height; ++y) {
+        uint32_t tmem_row_start = tile.tmem + y * tile.line;
+        bool odd_line = (y & 1u) != 0;
+        if (tile.siz == G_IM_SIZ_4b && (ul_x & 1u) != 0) {
+            uint32_t row_byte_offset = ((ul_y + y) * timg_.width + ul_x) / 2u;
+            for (uint32_t x = 0; x < words_per_row; ++x) {
+                uint32_t tmem_word = (tmem_row_start + x) & 0x1FFu;
+                uint32_t src_phys = timg_.phys_addr + row_byte_offset + x * 8;
+                for (uint32_t b = 0; b < 8; ++b) {
+                    uint8_t hi = read_rdram_u8(rdram, src_phys + b);
+                    uint8_t lo = read_rdram_u8(rdram, src_phys + b + 1);
+                    uint8_t byte_val = static_cast<uint8_t>(((hi & 0x0Fu) << 4) | ((lo >> 4) & 0x0Fu));
+                    uint32_t dest_byte = ((tmem_word * 8u + b) & 0xFFFu) ^ (odd_line ? 4u : 0u);
+                    tmem_[dest_byte] = byte_val;
+                }
+            }
+            continue;
+        }
+        uint32_t row_byte_offset = (tile.siz == G_IM_SIZ_4b)
+            ? (((ul_y + y) * timg_.width + ul_x) / 2u)
+            : (((ul_y + y) * timg_.width + ul_x) * bytes_per_texel);
+        for (uint32_t x = 0; x < words_per_row; ++x) {
+            uint32_t tmem_word = (tmem_row_start + x) & 0x1FFu;
+            uint32_t src_phys = timg_.phys_addr + row_byte_offset + x * 8;
+            for (uint32_t b = 0; b < 8; ++b) {
+                uint32_t dest_byte = ((tmem_word * 8u + b) & 0xFFFu) ^ (odd_line ? 4u : 0u);
+                tmem_[dest_byte] = read_rdram_u8(rdram, src_phys + b);
+            }
+        }
+    }
+}
+
+void TmemTextureCache::load_tlut(uint32_t tile_idx, uint32_t count, const uint8_t* rdram) {
+    tmem_generation_++;
+    TileDescriptor& tile = tiles_[tile_idx & 7];
+    uint32_t base_word = (tile.tmem >= 256u) ? tile.tmem : 256u;
+    uint32_t num_colors = count + 1;
+    for (uint32_t i = 0; i < num_colors; ++i) {
+        uint32_t tmem_word = base_word + i;
+        if (tmem_word >= 512u) {
+            break;
+        }
+        uint16_t color = read_rdram_u16(rdram, timg_.phys_addr + i * 2);
+        uint32_t dest_byte = tmem_word * 8u;
+        tmem_[dest_byte + 0] = static_cast<uint8_t>(color >> 8);
+        tmem_[dest_byte + 1] = static_cast<uint8_t>(color & 0xFF);
+    }
+}
+
+uint64_t TmemTextureCache::compute_hash(const TileDescriptor& tile, uint32_t width, uint32_t height, uint32_t textfilt, uint32_t textlut) const {
+    uint64_t hash = FNV1A_OFFSET_BASIS;
+    hash = fnv1a_step(hash, tile.fmt);
+    hash = fnv1a_step(hash, tile.siz);
+    hash = fnv1a_bytes(hash, &tile.line, sizeof(tile.line));
+    hash = fnv1a_bytes(hash, &tile.tmem, sizeof(tile.tmem));
+    hash = fnv1a_step(hash, tile.palette);
+    hash = fnv1a_step(hash, tile.clamp_s ? 1 : 0);
+    hash = fnv1a_step(hash, tile.mirror_s ? 1 : 0);
+    hash = fnv1a_step(hash, tile.mask_s);
+    hash = fnv1a_step(hash, tile.shift_s);
+    hash = fnv1a_step(hash, tile.clamp_t ? 1 : 0);
+    hash = fnv1a_step(hash, tile.mirror_t ? 1 : 0);
+    hash = fnv1a_step(hash, tile.mask_t);
+    hash = fnv1a_step(hash, tile.shift_t);
+    hash = fnv1a_bytes(hash, &width, sizeof(width));
+    hash = fnv1a_bytes(hash, &height, sizeof(height));
+    hash = fnv1a_bytes(hash, &textfilt, sizeof(textfilt));
+    hash = fnv1a_bytes(hash, &textlut, sizeof(textlut));
+
+    size_t start_byte = (tile.tmem * 8) % TMEM_SIZE;
+    size_t line_stride_words = (tile.line > 0) ? tile.line : ((width * get_bytes_per_texel_numerator(tile.siz) + 7) / 8);
+    size_t byte_count = std::min(line_stride_words * height * 8, TMEM_SIZE - start_byte);
+    if (byte_count == 0) {
+        byte_count = std::min(static_cast<size_t>(width * height * 2), TMEM_SIZE - start_byte);
+    }
+    hash = fnv1a_bytes(hash, tmem_ + start_byte, byte_count);
+
+    if (tile.fmt == G_IM_FMT_CI || textlut != G_TT_NONE) {
+        hash = fnv1a_bytes(hash, tmem_ + 0x800, 2048);
+    }
+    return hash;
+}
+
+void TmemTextureCache::decode_pixel(const TileDescriptor& tile, uint32_t x, uint32_t y, uint32_t textlut,
+                                    uint8_t& r, uint8_t& g, uint8_t& b, uint8_t& a) const {
+    if (tile.mask_s > 0 && tile.mask_s <= 10) {
+        uint32_t mask_w = 1u << tile.mask_s;
+        uint32_t masked_x = x & (mask_w - 1u);
+        x = (tile.mirror_s && ((x >> tile.mask_s) & 1u)) ? ((mask_w - 1u) - masked_x) : masked_x;
+    }
+    if (tile.mask_t > 0 && tile.mask_t <= 10) {
+        uint32_t mask_h = 1u << tile.mask_t;
+        uint32_t masked_y = y & (mask_h - 1u);
+        y = (tile.mirror_t && ((y >> tile.mask_t) & 1u)) ? ((mask_h - 1u) - masked_y) : masked_y;
+    }
+
+    uint32_t width = (tile.sh >= tile.sl) ? (((tile.sh - tile.sl) / 4) + 1) : 32;
+    bool use_tlut = (tile.fmt == G_IM_FMT_CI) || (textlut != G_TT_NONE);
+    bool odd_row = (y & 1u) != 0;
+
+    if (tile.siz == G_IM_SIZ_16b) {
+        uint32_t line_stride_bytes = (tile.line > 0) ? (tile.line * 8u) : (width * 2u);
+        uint32_t row_byte = x * 2u;
+        uint32_t byte_idx = ((tile.tmem * 8u + y * line_stride_bytes + row_byte) & 0xFFFu) ^ (odd_row ? 4u : 0u);
+        uint16_t val = (static_cast<uint16_t>(tmem_[byte_idx]) << 8) | tmem_[byte_idx + 1];
+
+        if (tile.fmt == G_IM_FMT_RGBA) {
+            r = ((val >> 11) & 0x1F) * 255 / 31;
+            g = ((val >> 6) & 0x1F) * 255 / 31;
+            b = ((val >> 1) & 0x1F) * 255 / 31;
+            a = (val & 1) ? 255 : 0;
+        } else if (tile.fmt == G_IM_FMT_IA) {
+            r = g = b = (val >> 8) & 0xFF;
+            a = val & 0xFF;
+        } else if (tile.fmt == G_IM_FMT_I) {
+            r = g = b = a = (val >> 8) & 0xFF;
+        } else {
+            r = g = b = 255;
+            a = 255;
+        }
+    } else if (tile.siz == G_IM_SIZ_8b) {
+        uint32_t line_stride_bytes = (tile.line > 0) ? (tile.line * 8u) : width;
+        uint32_t row_byte = x;
+        uint32_t byte_idx = ((tile.tmem * 8u + y * line_stride_bytes + row_byte) & 0xFFFu) ^ (odd_row ? 4u : 0u);
+        uint8_t val = tmem_[byte_idx];
+
+        if (use_tlut) {
+            uint32_t tlut_addr = 0x800u + static_cast<uint32_t>(val) * 8u;
+            uint16_t pal_color = (static_cast<uint16_t>(tmem_[tlut_addr]) << 8) | tmem_[tlut_addr + 1];
+            if (textlut == G_TT_IA16) {
+                r = g = b = (pal_color >> 8) & 0xFF;
+                a = pal_color & 0xFF;
+            } else {
+                r = ((pal_color >> 11) & 0x1F) * 255 / 31;
+                g = ((pal_color >> 6) & 0x1F) * 255 / 31;
+                b = ((pal_color >> 1) & 0x1F) * 255 / 31;
+                a = (pal_color & 1) ? 255 : 0;
+            }
+        } else if (tile.fmt == G_IM_FMT_IA) {
+            r = g = b = ((val >> 4) & 0x0F) * 255 / 15;
+            a = (val & 0x0F) * 255 / 15;
+        } else if (tile.fmt == G_IM_FMT_I) {
+            r = g = b = a = val;
+        } else {
+            r = g = b = val;
+            a = 255;
+        }
+    } else if (tile.siz == G_IM_SIZ_4b) {
+        uint32_t byte_idx = 0;
+        if (tile.line > 0) {
+            uint32_t line_stride_bytes = tile.line * 8u;
+            uint32_t row_byte = x / 2u;
+            byte_idx = ((tile.tmem * 8u + y * line_stride_bytes + row_byte) & 0xFFFu) ^ (odd_row ? 4u : 0u);
+        } else {
+            uint32_t row_stride = (width + 1u) / 2u;
+            byte_idx = (tile.tmem * 8u + y * row_stride + (x / 2u)) & 0xFFFu;
+        }
+        uint8_t byte_val = tmem_[byte_idx];
+        uint8_t nibble = ((x & 1) == 0) ? ((byte_val >> 4) & 0x0F) : (byte_val & 0x0F);
+
+        if (use_tlut) {
+            uint32_t pal_entry = static_cast<uint32_t>(tile.palette) * 16u + nibble;
+            uint32_t tlut_addr = 0x800u + pal_entry * 8u;
+            uint16_t pal_color = (static_cast<uint16_t>(tmem_[tlut_addr]) << 8) | tmem_[tlut_addr + 1];
+            if (textlut == G_TT_IA16) {
+                r = g = b = (pal_color >> 8) & 0xFF;
+                a = pal_color & 0xFF;
+            } else {
+                r = ((pal_color >> 11) & 0x1F) * 255 / 31;
+                g = ((pal_color >> 6) & 0x1F) * 255 / 31;
+                b = ((pal_color >> 1) & 0x1F) * 255 / 31;
+                a = (pal_color & 1) ? 255 : 0;
+            }
+        } else if (tile.fmt == G_IM_FMT_IA) {
+            r = g = b = ((nibble >> 1) & 0x07) * 255 / 7;
+            a = (nibble & 1) ? 255 : 0;
+        } else if (tile.fmt == G_IM_FMT_I) {
+            r = g = b = a = nibble * 255 / 15;
+        } else {
+            r = g = b = nibble * 255 / 15;
+            a = 255;
+        }
+    } else if (tile.siz == G_IM_SIZ_32b) {
+        uint32_t line_stride_bytes = (tile.line > 0) ? (tile.line * 8u) : (width * 2u);
+        uint32_t row_byte = x * 2u;
+        uint32_t rg_idx = ((tile.tmem * 8u + y * line_stride_bytes + row_byte) & 0xFFFu) ^ (odd_row ? 4u : 0u);
+        uint32_t ba_idx = ((((tile.tmem + 256u) & 0x1FFu) * 8u + y * line_stride_bytes + row_byte) & 0xFFFu) ^ (odd_row ? 4u : 0u);
+        r = tmem_[rg_idx];
+        g = tmem_[rg_idx + 1];
+        b = tmem_[ba_idx];
+        a = tmem_[ba_idx + 1];
+    } else {
+        r = g = b = a = 255;
+    }
+}
+
+CachedTexture TmemTextureCache::fetch_texture(uint32_t tile_idx, uint32_t textfilt, uint32_t textlut) {
+    uint32_t idx = tile_idx & 7;
+    auto& slot = fast_slots_[idx];
+    if (slot.valid &&
+        slot.tmem_gen == tmem_generation_ &&
+        slot.tile_gen == tile_generation_[idx] &&
+        slot.textfilt == textfilt &&
+        slot.textlut == textlut) {
+        tex_fast_count_++;
+        lru_list_.splice(lru_list_.begin(), lru_list_, slot.lru_iter);
+        return slot.texture;
+    }
+
+    const TileDescriptor& tile = tiles_[idx];
+    uint32_t width = (tile.sh >= tile.sl) ? (((tile.sh - tile.sl) / 4) + 1) : 32;
+    uint32_t height = (tile.th >= tile.tl) ? (((tile.th - tile.tl) / 4) + 1) : 32;
+    if (width == 0 || width > 512) {
+        width = (tile.line > 0) ? (tile.line * 4) : 32;
+    }
+    if (height == 0 || height > 512) {
+        height = 32;
+    }
+    if (!tile.clamp_s && tile.mask_s > 0 && tile.mask_s <= 9) {
+        width = 1u << tile.mask_s;
+    }
+    if (!tile.clamp_t && tile.mask_t > 0 && tile.mask_t <= 9) {
+        height = 1u << tile.mask_t;
+    }
+    width = std::clamp(width, 1u, 512u);
+    height = std::clamp(height, 1u, 512u);
+
+    uint64_t hash = compute_hash(tile, width, height, textfilt, textlut);
+    auto it = cache_map_.find(hash);
+    if (it != cache_map_.end()) {
+        tex_hit_count_++;
+        lru_list_.splice(lru_list_.begin(), lru_list_, it->second);
+        slot = { tmem_generation_, tile_generation_[idx], textfilt, textlut, true, *it->second, it->second };
+        return *it->second;
+    }
+
+    tex_upload_count_++;
+    decode_buffer_.resize(width * height * 4);
+    uint8_t* rgba = decode_buffer_.data();
+    for (uint32_t y = 0; y < height; ++y) {
+        for (uint32_t x = 0; x < width; ++x) {
+            uint8_t r = 0, g = 0, b = 0, a = 0;
+            decode_pixel(tile, x, y, textlut, r, g, b, a);
+            size_t pixel_idx = (y * width + x) * 4;
+            rgba[pixel_idx + 0] = r;
+            rgba[pixel_idx + 1] = g;
+            rgba[pixel_idx + 2] = b;
+            rgba[pixel_idx + 3] = a;
+        }
+    }
+
+    GLuint tex_id = 0;
+    bool recycled = false;
+    for (auto pool_it = recycled_textures_.begin(); pool_it != recycled_textures_.end(); ++pool_it) {
+        if (pool_it->width == width && pool_it->height == height) {
+            tex_id = pool_it->texture_id;
+            recycled_textures_.erase(pool_it);
+            recycled = true;
+            break;
+        }
+    }
+
+    if (!recycled) {
+        gl::glGenTextures(1, &tex_id);
+        gl::glBindTexture(GL_TEXTURE_2D, tex_id);
+        gl::glPixelStorei(GL_UNPACK_ALIGNMENT, 1);
+        gl::glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA, width, height, 0, GL_RGBA, GL_UNSIGNED_BYTE, rgba);
+    } else {
+        gl::glBindTexture(GL_TEXTURE_2D, tex_id);
+        gl::glPixelStorei(GL_UNPACK_ALIGNMENT, 1);
+        gl::glTexSubImage2D(GL_TEXTURE_2D, 0, 0, 0, width, height, GL_RGBA, GL_UNSIGNED_BYTE, rgba);
+    }
+
+    GLint min_mag = (textfilt == G_TF_POINT) ? GL_NEAREST : GL_LINEAR;
+    gl::glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, min_mag);
+    gl::glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, min_mag);
+
+    GLint wrap_s = (tile.clamp_s || tile.mask_s == 0) ? GL_CLAMP_TO_EDGE : (tile.mirror_s ? GL_MIRRORED_REPEAT : GL_REPEAT);
+    GLint wrap_t = (tile.clamp_t || tile.mask_t == 0) ? GL_CLAMP_TO_EDGE : (tile.mirror_t ? GL_MIRRORED_REPEAT : GL_REPEAT);
+    gl::glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, wrap_s);
+    gl::glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, wrap_t);
+
+    if (lru_list_.size() >= MAX_CACHE_ENTRIES) {
+        CachedTexture oldest = lru_list_.back();
+        lru_list_.pop_back();
+        cache_map_.erase(oldest.hash);
+        for (auto& s : fast_slots_) {
+            if (s.valid && s.texture.texture_id == oldest.texture_id) {
+                s.valid = false;
+            }
+        }
+        if (oldest.texture_id != 0) {
+            if (recycled_textures_.size() < MAX_RECYCLED_TEXTURES) {
+                recycled_textures_.push_back({ oldest.width, oldest.height, oldest.texture_id });
+            } else if (gl::glDeleteTextures) {
+                gl::glDeleteTextures(1, &oldest.texture_id);
+            }
+        }
+    }
+
+    CachedTexture new_entry{ hash, tex_id, width, height };
+    lru_list_.push_front(new_entry);
+    auto inserted_it = lru_list_.begin();
+    cache_map_[hash] = inserted_it;
+    slot = { tmem_generation_, tile_generation_[idx], textfilt, textlut, true, new_entry, inserted_it };
+    return new_entry;
+}
+
+TextureCacheStats TmemTextureCache::get_and_reset_stats() {
+    TextureCacheStats s{ tex_fast_count_, tex_hit_count_, tex_upload_count_ };
+    tex_fast_count_ = 0;
+    tex_hit_count_ = 0;
+    tex_upload_count_ = 0;
+    return s;
+}
+
+} // namespace snp::gles3
diff --git a/src/gles3/tmem_texture_cache.h b/src/gles3/tmem_texture_cache.h
new file mode 100644
index 0000000..92e12c3
--- /dev/null
+++ b/src/gles3/tmem_texture_cache.h
@@ -0,0 +1,124 @@
+#pragma once
+
+#include <cstdint>
+#include <vector>
+#include <list>
+#include <deque>
+#include <unordered_map>
+#include "gl_loader.h"
+#include "n64_gbi.h"
+
+namespace snp::gles3 {
+
+struct TileDescriptor {
+    uint8_t fmt = 0;
+    uint8_t siz = 0;
+    uint16_t line = 0;
+    uint16_t tmem = 0;
+    uint8_t palette = 0;
+    bool clamp_s = false;
+    bool mirror_s = false;
+    uint8_t mask_s = 0;
+    uint8_t shift_s = 0;
+    bool clamp_t = false;
+    bool mirror_t = false;
+    uint8_t mask_t = 0;
+    uint8_t shift_t = 0;
+    uint16_t sl = 0;
+    uint16_t tl = 0;
+    uint16_t sh = 0;
+    uint16_t th = 0;
+};
+
+struct TextureImageState {
+    uint8_t fmt = 0;
+    uint8_t siz = 0;
+    uint32_t width = 0;
+    uint32_t phys_addr = 0;
+};
+
+struct CachedTexture {
+    uint64_t hash = 0;
+    GLuint texture_id = 0;
+    uint32_t width = 0;
+    uint32_t height = 0;
+};
+
+struct TextureCacheStats {
+    uint32_t fast_hits = 0;
+    uint32_t map_hits = 0;
+    uint32_t uploads = 0;
+};
+
+class TmemTextureCache {
+public:
+    static constexpr size_t TMEM_SIZE = 4096;
+    static constexpr size_t MAX_CACHE_ENTRIES = 1024;
+    static constexpr size_t MAX_RECYCLED_TEXTURES = 128;
+    static constexpr size_t NUM_TILES = 8;
+
+    TmemTextureCache();
+    ~TmemTextureCache();
+
+    void reset();
+
+    void set_timg(uint8_t fmt, uint8_t siz, uint32_t width, uint32_t phys_addr);
+    void set_tile(uint32_t tile_idx, uint8_t fmt, uint8_t siz, uint16_t line, uint16_t tmem,
+                  uint8_t palette, bool clamp_t, bool mirror_t, uint8_t mask_t, uint8_t shift_t,
+                  bool clamp_s, bool mirror_s, uint8_t mask_s, uint8_t shift_s);
+    void set_tile_size(uint32_t tile_idx, uint16_t sl, uint16_t tl, uint16_t sh, uint16_t th);
+
+    void load_block(uint32_t tile_idx, uint32_t uls, uint32_t ult, uint32_t lrs, uint32_t dxt, const uint8_t* rdram);
+    void load_tile(uint32_t tile_idx, uint32_t uls, uint32_t ult, uint32_t lrs, uint32_t lrt, const uint8_t* rdram);
+    void load_tlut(uint32_t tile_idx, uint32_t count, const uint8_t* rdram);
+
+    CachedTexture fetch_texture(uint32_t tile_idx, uint32_t textfilt, uint32_t textlut);
+
+    const TileDescriptor& get_tile(uint32_t tile_idx) const { return tiles_[tile_idx & 7]; }
+    const TextureImageState& get_timg() const { return timg_; }
+    const uint8_t* get_tmem() const { return tmem_; }
+    void decode_pixel(const TileDescriptor& tile, uint32_t x, uint32_t y, uint32_t textlut,
+                      uint8_t& r, uint8_t& g, uint8_t& b, uint8_t& a) const;
+
+    TextureCacheStats get_and_reset_stats();
+    size_t recycled_pool_size() const { return recycled_textures_.size(); }
+
+private:
+    struct FastLookupSlot {
+        uint64_t tmem_gen = 0;
+        uint64_t tile_gen = 0;
+        uint32_t textfilt = 0;
+        uint32_t textlut = 0;
+        bool valid = false;
+        CachedTexture texture{};
+        std::list<CachedTexture>::iterator lru_iter{};
+    };
+
+    struct RecycledTexture {
+        uint32_t width = 0;
+        uint32_t height = 0;
+        GLuint texture_id = 0;
+    };
+
+    uint64_t compute_hash(const TileDescriptor& tile, uint32_t width, uint32_t height, uint32_t textfilt, uint32_t textlut) const;
+
+    uint8_t tmem_[TMEM_SIZE];
+    TileDescriptor tiles_[NUM_TILES];
+    TextureImageState timg_;
+
+    uint64_t tmem_generation_ = 1;
+    uint64_t tile_generation_[NUM_TILES] = { 1, 1, 1, 1, 1, 1, 1, 1 };
+    FastLookupSlot fast_slots_[NUM_TILES];
+
+    std::list<CachedTexture> lru_list_;
+    std::unordered_map<uint64_t, std::list<CachedTexture>::iterator> cache_map_;
+    std::deque<RecycledTexture> recycled_textures_;
+
+    uint32_t tex_fast_count_ = 0;
+    uint32_t tex_hit_count_ = 0;
+    uint32_t tex_upload_count_ = 0;
+
+    std::vector<uint8_t> decode_buffer_;
+};
+
+} // namespace snp::gles3
diff --git a/src/handheld/handheld_config.cpp b/src/handheld/handheld_config.cpp
new file mode 100644
index 0000000..76b4b49
--- /dev/null
+++ b/src/handheld/handheld_config.cpp
@@ -0,0 +1,303 @@
+#include "handheld_config.h"
+
+#include <algorithm>
+#include <filesystem>
+#include <fstream>
+#include <iostream>
+
+#include "toml++/toml.hpp"
+#include "ultramodern/config.hpp"
+#include "snp_recomp_hooks.h"
+
+namespace snp::gles3 {
+void set_vsync_enabled(bool enabled);
+} // namespace snp::gles3
+
+namespace snp::handheld {
+
+namespace {
+HandheldConfig g_config;
+} // namespace
+
+const HandheldConfig& get_config() {
+    return g_config;
+}
+
+HandheldConfig& get_mutable_config() {
+    return g_config;
+}
+
+std::string resolve_default_control_scheme() {
+    const char* env_sticks = std::getenv("ANALOG_STICKS");
+    if (!env_sticks || env_sticks[0] == '\0') {
+        env_sticks = std::getenv("SNP_ANALOG_STICKS");
+    }
+    if (env_sticks) {
+        try {
+            int sticks = std::stoi(env_sticks);
+            if (sticks >= 2) {
+                return CONTROL_SCHEME_TWIN_STICK;
+            }
+        } catch (...) {
+            // Unparseable stick count; default to stickless layout.
+        }
+    }
+    return CONTROL_SCHEME_DPAD_STRAFE_SHIFT;
+}
+
+void apply_graphics_config() {
+    snp::gles3::set_vsync_enabled(g_config.video.vsync);
+
+    ultramodern::renderer::GraphicsConfig config{};
+    config.developer_mode = false;
+    config.ar_option = (g_config.video.aspect_ratio == ASPECT_RATIO_EXPAND)
+        ? ultramodern::renderer::AspectRatio::Expand
+        : ultramodern::renderer::AspectRatio::Original;
+    config.res_option = (g_config.video.resolution_scale >= 2)
+        ? ultramodern::renderer::Resolution::Original2x
+        : ultramodern::renderer::Resolution::Original;
+    config.rr_option = ultramodern::renderer::RefreshRate::Original;
+    config.wm_option = ultramodern::renderer::WindowMode::Fullscreen;
+    config.hr_option = ultramodern::renderer::HUDRatioMode::Full;
+    config.api_option = ultramodern::renderer::GraphicsApi::Auto;
+    config.msaa_option = ultramodern::renderer::Antialiasing::None;
+    config.hpfb_option = ultramodern::renderer::HighPrecisionFramebuffer::Off;
+    ultramodern::renderer::set_graphics_config(config);
+}
+
+void save_config(const std::string& config_path) {
+    std::ofstream out(config_path);
+    if (!out.is_open()) {
+        std::cerr << "Failed to write configuration: " << config_path << "\n";
+        return;
+    }
+
+    out << "# Sin and Punishment Recompiled - Handheld Configuration\n\n"
+        << "[video]\n"
+        << "# Aspect ratio: \"expand\" (widescreen full screen) or \"original\" (4:3 pillarboxed)\n"
+        << "aspect_ratio = \"" << g_config.video.aspect_ratio << "\"\n"
+        << "# Resolution scale: 2 (native 480p) or 1 (original 240p)\n"
+        << "resolution_scale = " << g_config.video.resolution_scale << "\n"
+        << "vsync = " << (g_config.video.vsync ? "true" : "false") << "\n"
+        << "target_fps = " << g_config.video.target_fps << "\n"
+        << "sharp_textures = " << (g_config.video.sharp_textures ? "true" : "false") << "\n"
+        << "sharp_hud = " << (g_config.video.sharp_hud ? "true" : "false") << "\n\n"
+        << "[audio]\n"
+        << "master_volume = " << g_config.audio.master_volume << "\n"
+        << "music_volume = " << g_config.audio.music_volume << "\n"
+        << "sfx_volume = " << g_config.audio.sfx_volume << "\n\n"
+        << "[controls]\n"
+        << "# Scheme: \"auto\" (detect sticks), \"dpad_strafe_shift\" (Stickless default), \"bumper_strafe\", \"face_strafe\", \"dpad_aim\", \"dpad_strafe\", or \"twin_stick\"\n"
+        << "scheme = \"" << g_config.controls.scheme << "\"\n"
+        << "# Smart Lock-On: \"auto\" (Hold=Manual default), \"hold\" (Hold=Lock), or \"off\" (N64 toggle)\n"
+        << "smart_lock_on = \"" << g_config.controls.smart_lock_on << "\"\n"
+        << "aim_curve = \"" << g_config.controls.aim_curve << "\"\n"
+        << "# Face layout: \"nintendo\" (East A, South B, North X, West Y) or \"positional\" (swapped A<->B, X<->Y)\n"
+        << "face_layout = \"" << g_config.controls.face_layout << "\"\n"
+        << "stick_sensitivity = " << g_config.controls.stick_sensitivity << "\n"
+        << "deadzone = " << g_config.controls.deadzone << "\n"
+        << "analog_aim = " << (g_config.controls.analog_aim ? "true" : "false") << "\n"
+        << "rumble = " << (g_config.controls.rumble ? "true" : "false") << "\n"
+        << "swap_sticks = " << (g_config.controls.swap_sticks ? "true" : "false") << "\n\n"
+        << "[cheats]\n"
+        << "unlock_options = " << (g_config.cheats.unlock_options ? "true" : "false") << "\n"
+        << "infinite_health = " << (g_config.cheats.infinite_health ? "true" : "false") << "\n"
+        << "infinite_time = " << (g_config.cheats.infinite_time ? "true" : "false") << "\n"
+        << "infinite_continues = " << (g_config.cheats.infinite_continues ? "true" : "false") << "\n"
+        << "max_score = " << (g_config.cheats.max_score ? "true" : "false") << "\n"
+        << "invincible = " << (g_config.cheats.invincible ? "true" : "false") << "\n"
+        << "infinite_air_jumps = " << (g_config.cheats.infinite_air_jumps ? "true" : "false") << "\n\n"
+        << "[rom]\n"
+        << "# Preferred ROM region: \"auto\" (prefers English if present, else Japanese), \"en\", or \"jp\"\n"
+        << "preferred_region = \"" << g_config.rom.preferred_region << "\"\n";
+}
+
+bool load_config(const std::string& config_path) {
+    g_config.controls.scheme = resolve_default_control_scheme();
+
+    if (!std::filesystem::exists(config_path)) {
+        save_config(config_path);
+        return true;
+    }
+
+    try {
+        toml::table tbl = toml::parse_file(config_path);
+
+        if (auto video = tbl["video"].as_table()) {
+            g_config.video.aspect_ratio = video->get("aspect_ratio")->value_or(ASPECT_RATIO_EXPAND);
+            g_config.video.resolution_scale = static_cast<int>(video->get("resolution_scale")->value_or(int64_t(DEFAULT_RESOLUTION_SCALE)));
+            g_config.video.vsync = video->get("vsync")->value_or(true);
+            g_config.video.target_fps = static_cast<int>(video->get("target_fps")->value_or(int64_t(DEFAULT_TARGET_FPS)));
+            g_config.video.sharp_textures = video->get("sharp_textures")->value_or(false);
+            g_config.video.sharp_hud = video->get("sharp_hud")->value_or(true);
+        }
+
+        if (auto audio = tbl["audio"].as_table()) {
+            g_config.audio.master_volume = static_cast<int>(audio->get("master_volume")->value_or(int64_t(DEFAULT_VOLUME)));
+            g_config.audio.music_volume = static_cast<int>(audio->get("music_volume")->value_or(int64_t(DEFAULT_VOLUME)));
+            g_config.audio.sfx_volume = static_cast<int>(audio->get("sfx_volume")->value_or(int64_t(DEFAULT_VOLUME)));
+        }
+
+        if (auto controls = tbl["controls"].as_table()) {
+            g_config.controls.scheme = controls->get("scheme")->value_or(CONTROL_SCHEME_AUTO);
+            if (g_config.controls.scheme == CONTROL_SCHEME_AUTO) {
+                g_config.controls.scheme = resolve_default_control_scheme();
+            }
+            g_config.controls.smart_lock_on = controls->get("smart_lock_on")->value_or(SMART_LOCK_AUTO);
+            g_config.controls.aim_curve = controls->get("aim_curve")->value_or(AIM_CURVE_S_CURVE);
+            g_config.controls.face_layout = controls->get("face_layout")->value_or(FACE_LAYOUT_NINTENDO);
+            g_config.controls.stick_sensitivity = static_cast<float>(controls->get("stick_sensitivity")->value_or(double(DEFAULT_STICK_SENSITIVITY)));
+            g_config.controls.deadzone = static_cast<float>(controls->get("deadzone")->value_or(double(DEFAULT_DEADZONE)));
+            g_config.controls.analog_aim = controls->get("analog_aim")->value_or(true);
+            g_config.controls.rumble = controls->get("rumble")->value_or(true);
+            g_config.controls.swap_sticks = controls->get("swap_sticks")->value_or(false);
+
+            if (g_config.controls.scheme != CONTROL_SCHEME_DPAD_STRAFE_SHIFT &&
+                g_config.controls.scheme != CONTROL_SCHEME_BUMPER_STRAFE &&
+                g_config.controls.scheme != CONTROL_SCHEME_FACE_STRAFE &&
+                g_config.controls.scheme != CONTROL_SCHEME_DPAD_AIM &&
+                g_config.controls.scheme != CONTROL_SCHEME_DPAD_STRAFE &&
+                g_config.controls.scheme != CONTROL_SCHEME_TWIN_STICK) {
+                g_config.controls.scheme = resolve_default_control_scheme();
+            }
+
+            if (g_config.controls.smart_lock_on != SMART_LOCK_AUTO &&
+                g_config.controls.smart_lock_on != SMART_LOCK_HOLD &&
+                g_config.controls.smart_lock_on != SMART_LOCK_OFF) {
+                g_config.controls.smart_lock_on = SMART_LOCK_AUTO;
+            }
+
+            if (g_config.controls.aim_curve != AIM_CURVE_S_CURVE &&
+                g_config.controls.aim_curve != AIM_CURVE_LINEAR) {
+                g_config.controls.aim_curve = AIM_CURVE_S_CURVE;
+            }
+
+            g_config.controls.stick_sensitivity = std::clamp(g_config.controls.stick_sensitivity, 50.0f, 200.0f);
+            snp::config::set_stick_sensitivity(g_config.controls.stick_sensitivity);
+        }
+
+        if (auto cheats = tbl["cheats"].as_table()) {
+            g_config.cheats.unlock_options = cheats->get("unlock_options")->value_or(false);
+            g_config.cheats.infinite_health = cheats->get("infinite_health")->value_or(false);
+            g_config.cheats.infinite_time = cheats->get("infinite_time")->value_or(false);
+            g_config.cheats.infinite_continues = cheats->get("infinite_continues")->value_or(false);
+            g_config.cheats.max_score = cheats->get("max_score")->value_or(false);
+            g_config.cheats.invincible = cheats->get("invincible")->value_or(false);
+            g_config.cheats.infinite_air_jumps = cheats->get("infinite_air_jumps")->value_or(false);
+        }
+
+        if (auto rom = tbl["rom"].as_table()) {
+            g_config.rom.preferred_region = rom->get("preferred_region")->value_or(ROM_PREFERRED_AUTO);
+        }
+    } catch (const std::exception& e) {
+        std::cerr << "Warning: Error parsing " << config_path << ": " << e.what() << ", using defaults\n";
+        return false;
+    }
+
+    return true;
+}
+
+} // namespace snp::handheld
+
+namespace {
+constexpr uint32_t MUSIC_HANDLE_ADDRESS = 0x80074540;
+static uint32_t s_last_music_handle = 0;
+
+inline uint32_t read_rdram_u32(uint8_t* rdram, uint32_t vram) {
+    return *reinterpret_cast<uint32_t*>(rdram + (vram - 0x80000000u));
+}
+} // namespace
+
+extern "C" uint32_t snp_track_volume(uint8_t* rdram, uint32_t track, uint32_t volume) {
+    uint32_t music_handle = read_rdram_u32(rdram, MUSIC_HANDLE_ADDRESS);
+    if (music_handle != 0) {
+        s_last_music_handle = music_handle;
+    }
+    uint32_t handle = read_rdram_u32(rdram, track + 0x44);
+    bool is_music = (handle != 0 && handle == s_last_music_handle);
+
+    const auto& config = snp::handheld::get_config();
+    float channel_percent = is_music ? static_cast<float>(config.audio.music_volume) : static_cast<float>(config.audio.sfx_volume);
+    float master_factor = static_cast<float>(config.audio.master_volume) / 100.0f;
+    float factor = (channel_percent / 100.0f) * master_factor;
+
+    if (factor <= 0.0f) {
+        return 0;
+    }
+    if (factor >= 1.0f) {
+        return volume;
+    }
+    return static_cast<uint32_t>(volume * factor);
+}
+
+namespace snp::config {
+
+void add_general_options(recomp::config::Config&) {}
+bool get_rumble_pak() {
+    return snp::handheld::get_config().controls.rumble;
+}
+SecondPlayer get_second_player() {
+    return SecondPlayer::Off;
+}
+MouseAim get_mouse_aim() {
+    return MouseAim::Off;
+}
+float get_mouse_sensitivity() {
+    return 100.0f;
+}
+float get_stick_sensitivity() {
+    return snp::handheld::get_config().controls.stick_sensitivity;
+}
+void set_stick_sensitivity(float sensitivity) {
+    snp::handheld::get_mutable_config().controls.stick_sensitivity = std::clamp(sensitivity, 50.0f, 200.0f);
+}
+void add_graphics_options(recomp::config::Config&) {}
+uint32_t get_screen_filter() {
+    return 0;
+}
+bool get_screen_filter_menus_only() {
+    return false;
+}
+uint32_t get_bloom() {
+    return 0;
+}
+bool get_sharp_textures() {
+    return snp::handheld::get_config().video.sharp_textures;
+}
+bool get_sharp_hud() {
+    return snp::handheld::get_config().video.sharp_hud;
+}
+void apply_texture_packs() {}
+void lock_game_start_options() {}
+void add_extras_tabs() {}
+void add_sound_volume_options(recomp::config::Config&) {}
+void add_spanish_voices_option(recomp::config::Config&) {}
+void lock_spanish_voices_option() {}
+
+bool get_option(Option option) {
+    const auto& cheats = snp::handheld::get_config().cheats;
+    switch (option) {
+    case Option::UnlockOptions:
+        return cheats.unlock_options;
+    case Option::AnalogAim:
+        return snp::handheld::get_config().controls.analog_aim;
+    case Option::SmoothAiming:
+        return false;
+    case Option::InfiniteHealth:
+        return cheats.infinite_health;
+    case Option::InfiniteTime:
+        return cheats.infinite_time;
+    case Option::InfiniteContinues:
+        return cheats.infinite_continues;
+    case Option::MaxScore:
+        return cheats.max_score;
+    case Option::Invincible:
+        return cheats.invincible;
+    case Option::InfiniteAirJumps:
+        return cheats.infinite_air_jumps;
+    default:
+        return false;
+    }
+}
+
+} // namespace snp::config
